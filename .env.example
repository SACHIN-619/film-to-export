# Copy to .env and fill in:  Copy-Item .env.example .env
# .env is gitignored. Never commit it. If a key leaks, rotate it (docs/COMMON_STEPS.md → "If a key leaks").
PORT=8787

# ── Database (REQUIRED, also in SIMULATION mode) ─────────────────────────────
# Hosted Postgres. TLS is always used for remote hosts. The app refuses to start without it.
# Neon (recommended): neon.tech → your project → Connect → copy the connection string
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
#   DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Set to false ONLY if your provider's certificate chain fails verification (some Supabase setups).
DATABASE_SSL_VERIFY=true

# ── Gemini (vision AI) ───────────────────────────────────────────────────────
# Secret, server-only. aistudio.google.com → Get API key → Create API key. Blank = AI SIMULATION (labelled fixtures).
GEMINI_API_KEY=
# Any vision-capable Gemini model id.
GEMINI_MODEL=gemini-2.5-flash
# Optional: tried after retries when the main model is overloaded (HTTP 429/503), e.g. gemini-2.5-flash-lite.
GEMINI_FALLBACK_MODEL=

# Optional: public base URL used in shareable pay links and QR codes (e.g. your deployed URL).
# Blank = the address you opened the app on (localhost links only work on this computer).
APP_PUBLIC_URL=

# ── PayPal (SANDBOX ONLY, never paste Live credentials) ──────────────────────
# developer.paypal.com → Sandbox toggle ON → Apps & Credentials → your app.
# The API base is fixed to https://api-m.sandbox.paypal.com. Blank = payments SIMULATION (SIM- ids).
# Client ID: public; the browser's PayPal JS SDK receives it.
PAYPAL_CLIENT_ID=
# Secret: server-only. Never commit, never put in client code, never share.
PAYPAL_CLIENT_SECRET=
# Stretch: also create a draft invoice through the PayPal Invoicing API when an order is paid.
PAYPAL_CREATE_INVOICE=false

# ── Misc ────────────────────────────────────────────────────────────────────
# Second listing language for buyers (ISO 639-1): es, fr, de, ja, it, pt ...
BUYER_LANGUAGE=es
# Local folder for uploaded photos and extracted video frames (records live in Postgres).
DATA_DIR=./data
